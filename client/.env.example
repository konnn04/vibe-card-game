# ==============================================================================
# UNO Discord Activity - Client Configuration Template
# ==============================================================================

# 1. APP URL / DOMAIN CONFIGURATION
APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# 2. DISCORD APPLICATION & ACTIVITY CREDENTIALS
NEXT_PUBLIC_DISCORD_CLIENT_ID="your_discord_client_id_here"
DISCORD_CLIENT_SECRET="your_discord_client_secret_here"

# 3. BACKEND NESTJS CONFIGURATION (Internal Proxy)
# Next.js rewrites proxy /socket.io tới địa chỉ backend bên dưới
INTERNAL_SERVER_URL="http://localhost:3001"
PORT=3000
