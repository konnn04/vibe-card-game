# ==============================================================================
# UNO Discord Activity - Environment Configuration Template
# Sao chép file này thành `.env` hoặc `.env.local` và điền các giá trị thực tế của bạn
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APP URL / DOMAIN CONFIGURATION
# ------------------------------------------------------------------------------
# URL chạy ứng dụng (dùng cho SEO, sitemap, OAuth redirect, v.v.)
# Khi test local: http://localhost:3000
# Khi test qua Cloudflare Tunnel / ngrok: https://your-subdomain.trycloudflare.com
APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. DISCORD APPLICATION & ACTIVITY CREDENTIALS
# ------------------------------------------------------------------------------
# Lấy từ: Discord Developer Portal (https://discord.com/developers/applications)
# -> Chọn Application của bạn:
#   - General Information -> Application ID (Client ID)
#   - OAuth2 -> Client Secret
NEXT_PUBLIC_DISCORD_CLIENT_ID="123456789012345678"
DISCORD_CLIENT_SECRET="your_discord_client_secret_here"

# ------------------------------------------------------------------------------
# 3. FIREBASE REALTIME DATABASE (Client SDK)
# ------------------------------------------------------------------------------
# Lấy từ: Firebase Console (https://console.firebase.google.com/)
# -> Project settings -> General -> Your apps -> Web app -> Config
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyExampleKey1234567890abcdef"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_DATABASE_URL="https://your-project-id-default-rtdb.asia-southeast1.firebasedatabase.app"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"

# ------------------------------------------------------------------------------
# 4. FIREBASE ADMIN / SERVER CONFIGURATION (Tùy chọn)
# ------------------------------------------------------------------------------
# Dùng cho các API Route phía server (Next.js server-side)
# - FIREBASE_DATABASE_URL: Nếu trùng với client thì có thể để giống ở trên
# - FIREBASE_SERVICE_ACCOUNT_KEY: Lấy từ Project settings -> Service accounts -> Generate new private key
#   (Có thể paste chuỗi JSON, chuỗi base64 hoặc private key)
FIREBASE_DATABASE_URL="https://your-project-id-default-rtdb.asia-southeast1.firebasedatabase.app"
FIREBASE_SERVICE_ACCOUNT_KEY=""
