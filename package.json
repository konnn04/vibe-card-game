{
  "name": "card-game",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src app packages",
    "predev": "node scripts/gen-sfx-manifest.mjs && node scripts/gen-music-manifest.mjs && node scripts/gen-version.mjs",
    "prebuild": "node scripts/gen-sfx-manifest.mjs && node scripts/gen-music-manifest.mjs && node scripts/gen-version.mjs",
    "sfx": "node scripts/gen-sfx-manifest.mjs",
    "music": "node scripts/gen-music-manifest.mjs",
    "typecheck": "tsc --noEmit",
    "lint:fix": "eslint src app packages --fix",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "verify": "pnpm typecheck && pnpm lint && pnpm build",
    "pretypecheck": "node scripts/gen-version.mjs && next typegen",
    "stamp": "node scripts/gen-version.mjs",
    "rules": "node scripts/deploy-rules.mjs",
    "rules:deploy": "node scripts/deploy-rules.mjs --apply"
  },
  "dependencies": {
    "@discord/embedded-app-sdk": "^2.5.0",
    "@dnd-kit/core": "^6.3.1",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.1.1",
    "clsx": "^2.1.1",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.3.0",
    "framer-motion": "^13.2.0",
    "howler": "^2.2.4",
    "idb": "^8.0.3",
    "lucide-react": "^1.43.0",
    "next": "16.3.4",
    "next-intl": "^4.14.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-easy-crop": "^6.2.3",
    "three": "^0.186.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/howler": "^2.2.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=20.9"
  }
}
